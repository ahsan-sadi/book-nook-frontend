# Copy to .env (Next.js reads .env automatically)

# BetterAuth — signs JWTs and sets cookies
BETTER_AUTH_SECRET=change-me
# Origin this app runs on. The dev script pins port 3100:
#   npm run dev  ->  http://localhost:3100
BETTER_AUTH_URL=http://localhost:3100

# MongoDB connection used for BetterAuth collections (user/session/account)
DB_URL=mongodb://localhost:27017

# Books and borrows are backed by local mock data (lib/mock-data.js + lib/store.js),
# so no API server is needed. NEXT_PUBLIC_API_URL is no longer read.

# Google OAuth — authorized redirect URI:
# http://localhost:3100/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
