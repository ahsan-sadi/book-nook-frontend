# Copy to .env (Next.js reads .env automatically)

# BetterAuth — signs JWTs and sets cookies
BETTER_AUTH_SECRET=change-me
# Origin this app runs on (the dev script pins it: npm run dev -> http://localhost:3000).
# Must match CLIENT_URL in ../booknook-server/.env if you run the optional Express API.
BETTER_AUTH_URL=http://localhost:3000

# MongoDB connection used for BetterAuth collections (user/session/account/jwks)
# in the "booknook" database — the same database ../booknook-server uses.
MONGODB_URI=mongodb://localhost:27017

# Books and borrows are backed by local mock data (lib/mock-data.js + lib/store.js),
# so no API server is needed. NEXT_PUBLIC_API_URL is no longer read.

# Google OAuth — authorized redirect URI:
# http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
