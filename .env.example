# Copy to .env and fill in. Port 3000 is pinned (npm run dev passes -p 3000).

# --- BetterAuth (required) -------------------------------------------------
# Secret BetterAuth signs sessions and JWTs with — any long random string,
# e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Origin of this app. Doubles as the JWT iss/aud the Express API verifies, so it
# must equal AUTH_URL in ../booknook-server (.env there).
#   dev:  http://localhost:3000
#   prod: https://book-nook-frontend-self.vercel.app
BETTER_AUTH_URL=http://localhost:3000

# --- MongoDB (required) ----------------------------------------------------
# BetterAuth stores its collections in the "booknook" database of this cluster.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# --- Google sign-in (optional; leave empty to disable) ---------------------
# In Google Cloud Console use a "Web application" OAuth client and register the
# redirect URI exactly:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Unused ----------------------------------------------------------------
# Not read by any code — the API base URL is the BASE constant in lib/shelf-api.js.
NEXT_SERVER_URL=
